[TEMPLATE]
# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weatherdb
POSTGRES_USER=weather
POSTGRES_PASSWORD=12345
DATABASE_URL=postgresql://weather:${POSTGRES_PASSWORD}@postgres:5432/weatherdb

# ─── Kafka ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# ─── FastAPI ──────────────────────────────────────────
API_PORT=8000
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2y$12$vtGQWoFP/oVWzUA1pHW0ueCvSkAI1XuOdKi7FddyhrrPGEEhPjTGK               # REQUIRED — bcrypt hash

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# 5173 = Vite dev server (local non-Docker development)
# 3000 = React frontend when served through Docker (container port 5173 → host 3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────
# Base URL the browser uses to reach the FastAPI backend (exposed to the browser,
# so only public values here — never secrets). Used by services/frontend/src/api/client.js.
# Local dev fallback without this variable: http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# ─── Ingestion ────────────────────────────────────────
SYNTHETIC_ENABLED=true              # Set to false to skip synthetic batch on startup
OPENMETEO_POLL_INTERVAL_SECONDS=300
RSS_POLL_INTERVAL_SECONDS=300

# ─── Spark ────────────────────────────────────────────
SPARK_WRITE_PROCESSED_TOPIC=false
SPARK_CHECKPOINT_PATH=/data/checkpoints/spark_streaming
PG_WRITER_CHECKPOINT_PATH=/data/checkpoints/pg_writer

# ─── ML Configuration ─────────────────────────────────
CLASSIFIER_BACKEND=trained
MODEL_PATH=/opt/models/event_classifier/model.pkl
MODEL_CONFIDENCE_THRESHOLD=0.75
ML_CLUSTER_RADIUS_KM=3.0
ML_CLUSTER_TIME_WINDOW_MINUTES=30
ML_RECENT_EVENTS_WINDOW_MINUTES=30

# ─── Media Upload ─────────────────────────────────────
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_VIDEO_SIZE_MB=20
MEDIA_UPLOAD_PATH=/data/media

# ─── Storage ──────────────────────────────────────────
DATA_RAW_PATH=/data/raw
DATA_PROCESSED_PATH=/data/processed
DATA_SYNTHETIC_PATH=/data/synthetic
DATA_LOGS_PATH=/data/logs